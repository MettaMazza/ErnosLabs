# projects.ep — the portfolio / downloads page. Data-driven from
# assets/js/projects-data.js, which the mirror thread on the source machine
# regenerates (and pushes) whenever a repo changes — the pages never go stale.
#
#   projects.html : every project as a card, grouped by theme, with downloads.
#
# The ethos, made visible: the ⬇ Download served straight from Maria's machine
# (/projects/<repo>.zip on the funnel) whenever it's online; GitHub is only the
# fallback for when the machine sleeps. Authored in ErnosPlain like the rest
# of the site.

# The API base is resolved once by api-base.js (same-origin when the source
# machine serves the site, else the funnel).
define pj_base:
    if window.localStorage:
        set o to window.localStorage.getItem("ernosArchiveBase")
        if o:
            return o
    if window.ERNOS_API:
        return window.ERNOS_API
    return ""

define pj_gh with repo:
    if repo equals "Smithian-Fold-Theory-Of-Everything":
        return "https://github.com/MettaMazza/ernos-labs-sft-platform"
    return "https://github.com/MettaMazza/" + repo

define pj_desc with p:
    if p.repo equals "Smithian-Fold-Theory-Of-Everything":
        return "An open science platform and public knowledge tree connecting the current publications to claims, dependencies, controls and evidence."
    if p.repo equals "FoldBot-Chess":
        return "A full legal chess engine whose position values are counted from the board, with rule certification, match receipts and replayable games."
    if p.repo equals "Fold-Go":
        return "A Go project spanning exhaustive small-board verification and preserved full-board match records, built from counted connectivity and legality."
    if p.repo equals "Fold-Protein":
        return "A protein-structure research engine with committed coordinates, comparison scripts and an interactive ubiquitin reconstruction."
    if p.repo equals "UnisonAI":
        return "Active AI research built around inspectable memory, counted relationships, explicit component provenance and repeatable verification."
    if p.repo equals "Ernos-Programming-Language":
        return "A compiled language that reads like ordinary sentences, with a browser playground, native compiler and self-hosting toolchain."
    if p.repo equals "ErnosDecent":
        return "A local-first peer-to-peer application stack for identity, messaging, storage, publishing and other everyday network services."
    if p.repo equals "Ern-OS":
        return "A portable operating-system project written in ErnosPlain, with a sentence-based shell and a rebuild path from a C compiler."
    if p.repo equals "Civ-Seed":
        return "A self-contained collection of practical knowledge, readable digital sections and engraving-ready preservation files."
    return p.desc

define pj_esc with s:
    set t to s
    if t:
        set t to t.split("&").join("&amp;")
        set t to t.split("<").join("&lt;")
        set t to t.split(">").join("&gt;")
        return t
    return ""

# ---------- shared: the download links flip to the source machine ----------
define pj_use_machine:
    set links to document.querySelectorAll(".pj-dl")
    for each a in links:
        set repo to a.getAttribute("data-repo")
        if repo:
            set a.href to pj_base() + "/projects/" + repo + ".zip"
    return 0

define pj_status_set with cls and msg:
    set el to document.getElementById("pj-status")
    if el:
        set el.className to cls
        set el.innerHTML to msg
    return 0

define pj_status_ok with resp:
    if resp.ok:
        pj_use_machine()
        pj_status_set("ai-status is-online" and "<strong>Direct archive available.</strong> Downloads can be served from the Ernos Labs source machine.")
    else:
        pj_status_fail(resp)
    return 0

define pj_status_fail with err:
    pj_status_set("ai-status is-offline" and "<strong>GitHub archive available.</strong> The direct source machine is currently offline, so downloads use the public repository.")
    return 0

define pj_check:
    fetch(pj_base() + "/ping").then(pj_status_ok).catch(pj_status_fail)
    return 0

# ---------- the grid page ----------
define pj_meta_line with p:
    set out to ""
    if p.updated:
        set out to "updated " + p.updated
    if p.zip_size:
        if out equals "":
            set out to p.zip_size
        else:
            set out to out + " · " + p.zip_size
    return out

define pj_card with p:
    set page to pj_page(p.repo)
    set out to "<div class=\"ai-card reveal in\">"
    set out to out + f"<div class=\"ai-card__top\"><h3>{pj_esc(p.title)}</h3></div>"
    set out to out + f"<p class=\"ai-desc\">{pj_esc(pj_desc(p))}</p>"
    set out to out + f"<p class=\"pj-meta\">{pj_meta_line(p)}</p>"
    set out to out + "<div class=\"ai-card__actions\">"
    set out to out + f"<a class=\"btn btn--primary\" href=\"{page}\">Explore →</a>"
    set out to out + f"<a class=\"pj-dl\" data-repo=\"{p.repo}\" href=\"{pj_gh(p.repo)}/archive/refs/heads/main.zip\">⬇ Download .zip</a>"
    set out to out + f"<a class=\"pj-ghl\" href=\"{pj_gh(p.repo)}\" target=\"_blank\" rel=\"noopener\">GitHub ↗</a>"
    set out to out + "</div></div>"
    return out

define pj_site_card with title and description and page and action:
    set out to "<div class=\"ai-card reveal in\">"
    set out to out + f"<div class=\"ai-card__top\"><h3>{title}</h3></div>"
    set out to out + f"<p class=\"ai-desc\">{description}</p>"
    set out to out + "<p class=\"pj-meta\">Ernos Labs public collection</p>"
    set out to out + f"<div class=\"ai-card__actions\"><a class=\"btn btn--primary\" href=\"{page}\">{action} →</a></div></div>"
    return out

# Each project's dedicated, fully-featured page (falls back to GitHub-only repos).
define pj_page with repo:
    if repo equals "FoldBot-Chess":
        return "foldbot-chess.html"
    if repo equals "Fold-Go":
        return "fold-go.html"
    if repo equals "Fold-Protein":
        return "fold-protein.html"
    if repo equals "UnisonAI":
        return "unisonai.html"
    if repo equals "Ern-OS":
        return "ern-os.html"
    if repo equals "Civ-Seed":
        return "civ-seed.html"
    if repo equals "Ernos-Programming-Language":
        return "ernosplain.html"
    if repo equals "ErnosDecent":
        return "ernosdecent.html"
    if repo equals "Smithian-Fold-Theory-Of-Everything":
        return "smithian-fold-theory-of-everything.html"
    if repo equals "Smithian-Fold-Theory":
        return "smithian-fold-theory-of-everything.html"
    if repo equals "sft-dev":
        return "smithian-fold-theory-of-everything.html"
    if repo equals "ErnosLabs":
        return "index.html"
    return pj_gh(repo)

define pj_section with key and heading and sub:
    set cards to ""
    for each p in window.ERNOS_PROJECTS:
        set include to false
        if key equals "projects":
            if p.cat equals "platform":
                set include to true
            if p.cat equals "ai":
                set include to true
        else:
            if p.cat equals key:
                set include to true
        if p.repo equals "Smithian-Fold-Theory":
            set include to false
        if p.repo equals "sft-dev":
            set include to false
        if include:
            set cards to cards + pj_card(p)
    if key equals "preserve":
        set cards to cards + pj_site_card("Seed Vault" and "A readable, searchable route through the knowledge selected for long-term preservation, available in the browser or as downloadable text." and "seed.html" and "Read the vault")
        set cards to cards + pj_site_card("AI Archive" and "Open model files kept with their formats, licences, checksums, source links and the programs needed to run them again." and "ai.html" and "Browse the archive")
    if cards equals "":
        return ""
    set out to f"<hr class=\"divider\" style=\"margin:34px 0 26px\"><h2>{heading}</h2>"
    set out to out + f"<p class=\"lead\" style=\"margin-bottom:24px\">{sub}</p>"
    set out to out + "<div class=\"ai-grid\">" + cards + "</div>"
    return out

define pj_render_grid:
    set host to document.getElementById("projects-grid")
    if not host:
        return 0
    set html to ""
    set html to html + pj_section("theory" and "Theory" and "The current Smithian Fold Theory platform, publications and public knowledge record.")
    set html to html + pj_section("projects" and "Projects" and "Languages, local systems, peer-to-peer infrastructure and active AI research—with working interfaces and source code.")
    set html to html + pj_section("engines" and "Engines" and "Chess, Go and protein-structure showcases that make the method visible through interactive results and reproducible files.")
    set html to html + pj_section("preserve" and "Preservation" and "Knowledge and software prepared to remain useful beyond their original machine, service or moment.")
    set host.innerHTML to html
    return 0

define main:
    pj_render_grid()
    window.ernosApiReady.then(pj_check_cb)
    return 0

define pj_check_cb with basev:
    pj_check()
    return 0
